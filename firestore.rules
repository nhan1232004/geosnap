rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validOptionalStringLength(field, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= maxLen);
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "nguoicoich1234@gmail.com" && request.auth.token.email_verified == true));
    }

    // Check if two users are friends
    function areFriends(uid1, uid2) {
      return (
        exists(/databases/$(database)/documents/friendships/$(uid1 + '_' + uid2)) ||
        exists(/databases/$(database)/documents/friendships/$(uid2 + '_' + uid1))
      );
    }

    // ===============================================================
    // Validators
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(['uid', 'email', 'role', 'createdAt']) &&
             data.uid is string &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['admin', 'user'] &&
             data.createdAt is string &&
             validOptionalStringLength('displayName', 100) &&
             validOptionalStringLength('avatarUrl', 2048) &&
             validOptionalStringLength('inviteCode', 20) &&
             validOptionalStringLength('bio', 300);
    }

    function isValidPhoto(data) {
      return hasRequiredFields(['uid', 'url', 'uploadedAt', 'hasGps']) &&
             data.uid is string &&
             data.url is string && data.url.size() <= 10485760 &&
             data.uploadedAt is string &&
             data.hasGps is bool &&
             (!( 'latitude' in data ) || data.latitude is number) &&
             (!( 'longitude' in data ) || data.longitude is number) &&
             (!( 'takenAt' in data ) || data.takenAt is string) &&
             (!( 'folderId' in data ) || data.folderId is string);
    }

    function isValidFolder(data) {
      return hasRequiredFields(['uid', 'name', 'centerLat', 'centerLng', 'photoCount', 'createdAt']) &&
             data.uid is string &&
             data.name is string && data.name.size() <= 500 &&
             data.centerLat is number &&
             data.centerLng is number &&
             data.photoCount is number && data.photoCount >= 0 &&
             data.createdAt is string &&
             validOptionalStringLength('country', 100) &&
             validOptionalStringLength('city', 100) &&
             validOptionalStringLength('district', 100) &&
             validOptionalStringLength('street', 100) &&
             validOptionalStringLength('coverPhotoUrl', 10485760) &&
             (!( 'firstVisitedAt' in data ) || data.firstVisitedAt is string) &&
             (!( 'lastVisitedAt' in data ) || data.lastVisitedAt is string) &&
             (!( 'visibility' in data ) || data.visibility in ['private', 'friends', 'public']) &&
             validOptionalStringLength('description', 500);
    }

    function isValidFriendship(data) {
      return hasRequiredFields(['requesterId', 'addresseeId', 'status', 'createdAt']) &&
             data.requesterId is string &&
             data.addresseeId is string &&
             data.status in ['pending', 'accepted', 'blocked'] &&
             data.createdAt is string;
    }

    function isValidNotification(data) {
      return hasRequiredFields(['recipientId', 'actorId', 'type', 'isRead', 'createdAt']) &&
             data.recipientId is string &&
             data.actorId is string &&
             data.type in ['friend_request', 'friend_accepted', 'reaction', 'comment', 'new_location'] &&
             data.isRead is bool &&
             data.createdAt is string;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      // Anyone authenticated can read (for invite lookup by inviteCode query, profile view)
      allow read: if isAuthenticated();
      // Create: User can create their own doc, OR auto-generated via Auth (backend)
      allow create: if isOwner(userId) && isValidUser(request.resource.data) &&
                    uidUnchanged() &&
                    ((request.resource.data.role == 'user') || isAdmin());
      // Allow creation without full validation for mobile compatibility
      allow create: if isOwner(userId) && request.resource.data.uid == userId &&
                    request.resource.data.email is string &&
                    request.resource.data.role == 'user' &&
                    request.resource.data.createdAt is string;
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) &&
                    request.resource.data.role == resource.data.role &&
                    request.resource.data.createdAt == resource.data.createdAt) ||
                    (isAdmin() && isValidUser(request.resource.data));
    }

    match /photos/{photoId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidPhoto(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidPhoto(request.resource.data) &&
                    uidNotModified() &&
                    request.resource.data.uploadedAt == resource.data.uploadedAt;
      allow delete: if isDocOwner() || isAdmin();
    }

    match /folders/{folderId} {
      // Owner can always read; friends can read if visibility is 'friends' or 'public'; anyone if 'public'
      allow read: if isDocOwner() || isAdmin() ||
                  (isAuthenticated() && resource.data.visibility == 'public') ||
                  (isAuthenticated() && resource.data.visibility == 'friends');
      allow create: if isAuthenticated() && isValidFolder(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidFolder(request.resource.data) &&
                    uidNotModified() &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isDocOwner() || isAdmin();
    }

    // ---------------------------------------------------------------
    // Friendships
    // ---------------------------------------------------------------
    match /friendships/{friendshipId} {
      // Can read if you are requester or addressee
      allow read: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.addresseeId == request.auth.uid
      );
      // Can create a friendship request (you must be the requester)
      allow create: if isAuthenticated() &&
                    isValidFriendship(request.resource.data) &&
                    request.resource.data.requesterId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      // Can update if you are addressee (accept/decline) or requester (cancel)
      allow update: if isAuthenticated() && (
        resource.data.addresseeId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.addresseeId == request.auth.uid
      );
    }

    // ---------------------------------------------------------------
    // Notifications
    // ---------------------------------------------------------------
    match /notifications/{notificationId} {
      // Only recipient can read their own notifications
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      // Anyone authenticated can create a notification (sending to another user)
      allow create: if isAuthenticated() && isValidNotification(request.resource.data);
      // Only recipient can update (mark as read)
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Comments
    // ---------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.content is string &&
                    request.resource.data.content.size() <= 500 &&
                    (( 'folderId' in request.resource.data && request.resource.data.folderId is string ) ||
                     ( 'postId' in request.resource.data && request.resource.data.postId is string )) &&
                    request.resource.data.createdAt is string;
      allow update: if false; // Comments are immutable
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Posts
    // ---------------------------------------------------------------
    match /posts/{postId} {
      // Any authenticated user can read posts.
      // Visibility filtering (friends/public/private) is enforced client-side.
      // This allows collection queries without requiring composite indexes.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    request.resource.data.uid == request.auth.uid &&
                    request.resource.data.type in ['post', 'story'] &&
                    request.resource.data.content is string &&
                    request.resource.data.imageUrls is list &&
                    request.resource.data.visibility in ['public', 'friends', 'private'] &&
                    request.resource.data.createdAt is string;
      allow update: if isDocOwner() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'commentCount', 'shareCount']));
      allow delete: if isDocOwner() || isAdmin();
    }

    // ---------------------------------------------------------------
    // Messages
    // ---------------------------------------------------------------
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    request.resource.data.senderId == request.auth.uid &&
                    request.resource.data.conversationId is string &&
                    request.resource.data.recipientId is string &&
                    request.resource.data.content is string &&
                    request.resource.data.content.size() <= 1000 &&
                    request.resource.data.createdAt is string;
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }
  }
}
