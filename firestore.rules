rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validOptionalStringLength(field, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= maxLen);
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.admin == true)
      );
    }


    // Check if friendship exists and is accepted
    function isFriendshipAccepted(uid1, uid2) {
      let doc1 = get(/databases/$(database)/documents/friendships/$(uid1 + '_' + uid2));
      let doc2 = get(/databases/$(database)/documents/friendships/$(uid2 + '_' + uid1));
      
      return (
        (exists(doc1.path) && doc1.data.status == 'accepted') ||
        (exists(doc2.path) && doc2.data.status == 'accepted')
      );
    }

    // Helper: check if current user can read a folder by its visibility
    function canReadFolder(folderId) {
      let folder = get(/databases/$(database)/documents/folders/$(folderId));
      return exists(folder.path) && (
        folder.data.uid == request.auth.uid ||
        folder.data.visibility == 'public' ||
        (folder.data.visibility == 'friends' && isFriendshipAccepted(request.auth.uid, folder.data.uid))
      );
    }

    // Helper: check if current user can read a post by its visibility
    function canReadPost(postId) {
      let post = get(/databases/$(database)/documents/posts/$(postId));
      return exists(post.path) && (
        post.data.uid == request.auth.uid ||
        post.data.visibility == 'public' ||
        (post.data.visibility == 'friends' && isFriendshipAccepted(request.auth.uid, post.data.uid))
      );
    }

    // Helper: check if current user can read a page by its visibility
    function canReadPage(pageId) {
      let page = get(/databases/$(database)/documents/pages/$(pageId));
      return exists(page.path) && (
        page.data.createdBy == request.auth.uid ||
        page.data.visibility == 'public' ||
        (page.data.visibility == 'friends' && isFriendshipAccepted(request.auth.uid, page.data.createdBy))
      );
    }

    // ===============================================================
    // Validators
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(['uid', 'email', 'role', 'createdAt']) &&
             data.uid is string &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['admin', 'user'] &&
             data.createdAt is string &&
             validOptionalStringLength('displayName', 100) &&
             validOptionalStringLength('avatarUrl', 2048) &&
             validOptionalStringLength('inviteCode', 20) &&
             validOptionalStringLength('bio', 300);
    }

    function isValidPhoto(data) {
      return hasRequiredFields(['uid', 'url', 'uploadedAt', 'hasGps']) &&
             data.uid is string &&
             data.url is string && data.url.size() <= 2048 &&
             data.uploadedAt is string &&
             data.hasGps is bool &&
             (!( 'latitude' in data ) || data.latitude is number) &&
             (!( 'longitude' in data ) || data.longitude is number) &&
             (!( 'takenAt' in data ) || data.takenAt is string) &&
             (!( 'folderId' in data ) || data.folderId is string) &&
             (!( 'visibility' in data ) || data.visibility in ['private', 'friends', 'public']);
    }

    function isValidFolder(data) {
      return hasRequiredFields(['uid', 'name', 'centerLat', 'centerLng', 'photoCount', 'createdAt']) &&
             data.uid is string &&
             data.name is string && data.name.size() <= 500 &&
             data.centerLat is number &&
             data.centerLng is number &&
             data.photoCount is number && data.photoCount >= 0 &&
             data.createdAt is string &&
             validOptionalStringLength('country', 100) &&
             validOptionalStringLength('city', 100) &&
             validOptionalStringLength('district', 100) &&
             validOptionalStringLength('street', 100) &&
             validOptionalStringLength('coverPhotoUrl', 2048) &&
             (!( 'firstVisitedAt' in data ) || data.firstVisitedAt is string) &&
             (!( 'lastVisitedAt' in data ) || data.lastVisitedAt is string) &&
             (!( 'visibility' in data ) || data.visibility in ['private', 'friends', 'public']) &&
             validOptionalStringLength('description', 500);
    }

    function isValidFriendship(data) {
      return hasRequiredFields(['requesterId', 'addresseeId', 'status', 'createdAt']) &&
             data.requesterId is string &&
             data.addresseeId is string &&
             data.status in ['pending', 'accepted', 'blocked'] &&
             data.createdAt is string;
    }

    function isValidNotification(data) {
      return hasRequiredFields(['recipientId', 'actorId', 'type', 'isRead', 'createdAt']) &&
             data.recipientId is string &&
             data.actorId is string &&
             data.type in ['friend_request', 'friend_accepted', 'reaction', 'comment', 'new_location'] &&
             data.isRead is bool &&
             data.createdAt is string;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // ---------------------------------------------------------------
    // Users (Fix #1: Only owner, admin, or accepted friends can read)
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() ||
                     (isAuthenticated() && isFriendshipAccepted(request.auth.uid, userId));
      allow create: if isOwner(userId) && isValidUser(request.resource.data) &&
                     uidUnchanged() &&
                     ((request.resource.data.role == 'user') || isAdmin());
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) &&
                     request.resource.data.role == resource.data.role &&
                     request.resource.data.createdAt == resource.data.createdAt) ||
                     (isAdmin() && isValidUser(request.resource.data));
    }

    match /photos/{photoId} {
      allow read: if isDocOwner() || isAdmin() ||
                  (isAuthenticated() && (
                    ( 'visibility' in resource.data && resource.data.visibility == 'public' ) ||
                    ( 'visibility' in resource.data && resource.data.visibility == 'friends' && isFriendshipAccepted(request.auth.uid, resource.data.uid) )
                  ));
      allow create: if isAuthenticated() && isValidPhoto(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidPhoto(request.resource.data) &&
                     uidNotModified() &&
                     request.resource.data.uploadedAt == resource.data.uploadedAt;
      allow delete: if isDocOwner() || isAdmin();
    }

    match /folders/{folderId} {
      allow read: if isDocOwner() || isAdmin() ||
                  (isAuthenticated() && resource.data.visibility == 'public') ||
                  (isAuthenticated() && resource.data.visibility == 'friends' && isFriendshipAccepted(request.auth.uid, resource.data.uid));
      allow create: if isAuthenticated() && isValidFolder(request.resource.data) && uidUnchanged();
      allow update: if isDocOwner() && isValidFolder(request.resource.data) &&
                     uidNotModified() &&
                     request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isDocOwner() || isAdmin();
    }

    // ---------------------------------------------------------------
    // Friendships (B3 Fix: Only addressee can accept or block)
    // ---------------------------------------------------------------
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.addresseeId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
                     isValidFriendship(request.resource.data) &&
                     request.resource.data.requesterId == request.auth.uid &&
                     request.resource.data.status == 'pending';
      allow update: if isAuthenticated() &&
                     resource.data.addresseeId == request.auth.uid &&
                     request.resource.data.status in ['accepted', 'blocked'];
      allow delete: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.addresseeId == request.auth.uid
      );
    }

    // ---------------------------------------------------------------
    // Notifications (B3 Fix: Enforce actorId == request.auth.uid)
    // ---------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated() &&
                     isValidNotification(request.resource.data) &&
                     request.resource.data.actorId == request.auth.uid;
      allow update: if isAuthenticated() &&
                     resource.data.recipientId == request.auth.uid &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Comments (Fix #3: Check parent folder/post visibility)
    // ---------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if isAuthenticated() && (
        // Comment author can always read their own comments
        resource.data.uid == request.auth.uid ||
        isAdmin() ||
        // Comment on a folder — check folder visibility
        ('folderId' in resource.data && canReadFolder(resource.data.folderId)) ||
        // Comment on a post — check post visibility
        ('postId' in resource.data && canReadPost(resource.data.postId))
      );
      allow create: if isAuthenticated() &&
                     request.resource.data.uid == request.auth.uid &&
                     request.resource.data.content is string &&
                     request.resource.data.content.size() <= 500 &&
                     (( 'folderId' in request.resource.data && request.resource.data.folderId is string ) ||
                      ( 'postId' in request.resource.data && request.resource.data.postId is string )) &&
                     request.resource.data.createdAt is string;
      allow update: if false; // Comments are immutable
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Posts (Fix #2: Require read access to update reactions/counts)
    // ---------------------------------------------------------------
    match /posts/{postId} {
      allow read: if isDocOwner() || isAdmin() ||
                  (isAuthenticated() && resource.data.visibility == 'public') ||
                  (isAuthenticated() && resource.data.visibility == 'friends' && isFriendshipAccepted(request.auth.uid, resource.data.uid));
      allow create: if isAuthenticated() &&
                     request.resource.data.uid == request.auth.uid &&
                     request.resource.data.type in ['post', 'story'] &&
                     request.resource.data.content is string &&
                     request.resource.data.imageUrls is list &&
                     request.resource.data.visibility in ['public', 'friends', 'private'] &&
                     request.resource.data.createdAt is string;
      allow update: if isDocOwner() ||
                     // Non-owners can only update reactions/counts AND must have read access
                     (isAuthenticated() &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'commentCount', 'shareCount']) &&
                      (resource.data.visibility == 'public' ||
                       (resource.data.visibility == 'friends' && isFriendshipAccepted(request.auth.uid, resource.data.uid))));
      allow delete: if isDocOwner() || isAdmin();
    }

    // ---------------------------------------------------------------
    // Messages
    // ---------------------------------------------------------------
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
                     request.resource.data.senderId == request.auth.uid &&
                     request.resource.data.conversationId is string &&
                     request.resource.data.recipientId is string &&
                     request.resource.data.content is string &&
                     request.resource.data.content.size() <= 1000 &&
                     request.resource.data.createdAt is string;
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Workspaces (B1: Owner & Member Isolation)
    // ---------------------------------------------------------------
    match /workspaces/{workspaceId} {
      function isWorkspaceMember() {
        return isAuthenticated() && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.members
        );
      }
      allow read: if isWorkspaceMember();
      allow create: if isAuthenticated() &&
                     request.resource.data.ownerId == request.auth.uid &&
                     request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.members
      );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Pages (Fix: friends visibility now checks isFriendshipAccepted)
    // ---------------------------------------------------------------
    match /pages/{pageId} {
      allow read: if (resource.data.visibility == 'public') ||
                     (isAuthenticated() && (
                       resource.data.createdBy == request.auth.uid ||
                       (resource.data.visibility == 'friends' &&
                        isFriendshipAccepted(request.auth.uid, resource.data.createdBy))
                     ));
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        request.resource.data.updatedBy == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Blocks (Fix #4: Read scoped to page visibility, not just auth)
    // ---------------------------------------------------------------
    match /blocks/{blockId} {
      allow read: if (isAuthenticated() && canReadPage(resource.data.pageId)) ||
                     // Unauthenticated users can read blocks of public pages
                     (!isAuthenticated() &&
                       exists(/databases/$(database)/documents/pages/$(resource.data.pageId)) &&
                       get(/databases/$(database)/documents/pages/$(resource.data.pageId)).data.visibility == 'public');
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        request.resource.data.updatedBy == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Assets (Fix #5a: Read scoped to uploader or admin)
    // ---------------------------------------------------------------
    match /assets/{assetId} {
      allow read: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.uploadedBy == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uploadedBy == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uploadedBy == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Share Grants (Fix #5b: Read scoped to granter or grantee)
    // ---------------------------------------------------------------
    match /shares/{shareId} {
      allow read: if isAuthenticated() && (
        resource.data.grantedBy == request.auth.uid ||
        resource.data.grantedTo == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.grantedBy == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.grantedBy == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.grantedBy == request.auth.uid;
    }
  }
}
