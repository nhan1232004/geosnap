rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------------------------------------------------------------
    // Posts images: posts/{userId}/{filename}
    // ---------------------------------------------------------------
    match /posts/{userId}/{filename} {
      // Only the owner can upload
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024  // max 10 MB
                   && request.resource.contentType.matches('image/.*');
      // Anyone authenticated can view
      allow read: if request.auth != null;
    }

    // ---------------------------------------------------------------
    // Stories images: stories/{userId}/{filename}
    // ---------------------------------------------------------------
    match /stories/{userId}/{filename} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024  // max 10 MB
                   && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
    }

    // ---------------------------------------------------------------
    // User avatars: avatars/{userId}/{filename}
    // ---------------------------------------------------------------
    match /avatars/{userId}/{filename} {
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024   // max 5 MB
                   && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
    }
  }
}
