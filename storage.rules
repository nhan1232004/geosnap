rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------------------------------------------------------------
    // Photos: photos/{userId}/{filename}
    // ---------------------------------------------------------------
    match /photos/{userId}/{filename} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // ---------------------------------------------------------------
    // Posts images: posts/{userId}/{filename}
    // ---------------------------------------------------------------
    match /posts/{userId}/{filename} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // ---------------------------------------------------------------
    // Stories images: stories/{userId}/{filename}
    // ---------------------------------------------------------------
    match /stories/{userId}/{filename} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // ---------------------------------------------------------------
    // User avatars & covers: avatars/{userId}/{filename}, covers/{userId}/{filename}
    // ---------------------------------------------------------------
    match /avatars/{userId}/{filename} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    match /covers/{userId}/{filename} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // ---------------------------------------------------------------
    // Workspace assets: workspaces/{workspaceId}/{filename}
    // ---------------------------------------------------------------
    match /workspaces/{workspaceId}/{filename} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }

    // Fallback for any user files
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }
  }
}
